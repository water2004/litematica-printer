{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "icon": "assets/litematica-printer/icon.png",
  "name": "${mod_name}",
  "description": "An extension for Litematica that adds printing, filling, fluid removal, and bedrock breaking as independent modules.",
  "authors": [
    "aleksilassila",
    "zhaixianyu",
    "BlinkWhite",
    "bunnyi116"
  ],
  "contact": {
    "website": "${mod_homepage}",
    "homepage": "${mod_sources}",
    "sources": "${mod_sources}"
  },
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.aleksilassila.litematica.printer.LitematicaPrinterMod"
    ],
    "modmenu": [
      "me.aleksilassila.litematica.printer.interfaces.compat.ModMenuCompat"
    ]
  },
  "mixins": [
    "litematica-printer.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_dependency}",
    "malilib": ">=${malilib}",
    "litematica": ">=${litematica}",
    "fabric-content-registries-v0": "*"
  },
  "suggests": {
    "chainveinfabric": ">=3.0.0"
  }
}
